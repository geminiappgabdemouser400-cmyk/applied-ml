   "source": [
    "### Compare logits with HuggingFace model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "100%|██████████| 4/4 [00:01<00:00,  2.27it/s]\n",
      "100%|██████████| 4/4 [00:00<00:00, 32.73it/s]\n"
     ]
    }
   ],
   "source": [
    "# NBVAL_IGNORE_OUTPUT\n",
    "prompts = [\n",
    "    \"The capital of Germany is\",\n",
    "    \"2 * 42 = \",\n",
    "    \"My favorite\",\n",
    "    \"aosetuhaosuh aostud aoestuaoentsudhasuh aos tasat naostutshaosuhtnaoe usaho uaotsnhuaosntuhaosntu haouaoshat u saotheu saonuh aoesntuhaosut aosu thaosu thaoustaho usaothusaothuao sutao sutaotduaoetudet uaosthuao uaostuaoeu aostouhsaonh aosnthuaoscnuhaoshkbaoesnit haosuhaoe uasotehusntaosn.p.uo ksoentudhao ustahoeuaso usant.hsa otuhaotsi aostuhs\",\n",
    "]\n",
    "\n",
    "# Access the underlying HF model and tokenizer from the bridge\n",
    "hf_model = model.original_model\n",
    "tokenizer = model.tokenizer\n",
    "device = model.cfg.device\n",
    "\n",
    "model.eval()\n",
    "hf_model.eval()\n",
    "prompt_ids = [tokenizer.encode(prompt, return_tensors=\"pt\").to(device) for prompt in prompts]\n",
    "tl_logits = [model(ids).detach().cpu() for ids in tqdm(prompt_ids)]\n",
    "\n",
    "logits = [hf_model(ids).logits.detach().cpu() for ids in tqdm(prompt_ids)]\n",
    "\n",
    "for i in range(len(prompts)):\n",
    "    assert torch.allclose(logits[i], tl_logits[i], atol=1e-4, rtol=1e-2)"
   ]
  },
