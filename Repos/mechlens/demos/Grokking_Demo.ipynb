      "        [  0,   4, 113]], device='cuda:0')\n",
      "torch.Size([12769, 3])\n"
     ]
    }
   ],
   "source": [
    "dataset = torch.stack([a_vector, b_vector, equals_vector], dim=1).to(device)\n",
